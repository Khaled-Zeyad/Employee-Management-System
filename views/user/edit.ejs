<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <script src="/js/color-modes.js"></script>
    <link
      rel="stylesheet"
      href="/bootstrap-icons-1.10.5/font/bootstrap-icons.min.css"
    />
    <link rel="shortcut icon" href="/img/ali.png" type="image/x-icon" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Khaled Zeyad" />
    <meta name="generator" content="rwx01" />
    <title>Edit Employee Details</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/dark-light.css" rel="stylesheet" />
    <link href="/css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/myStyle.css" />
  </head>
  <body>
    <%- include('../components/dark-light.ejs') %>

    <main class="d-flex flex-nowrap">
      <%- include('../components/sidebar.ejs', {currentPath: "edit"}) %>

      <section class="w-100">
        <%- include('../components/navbar.ejs') %>
        <nav
          class="mt-4 d-flex flex-wrap justify-content-between"
          style="padding: 0 2rem"
          aria-label="breadcrumb"
        >
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              <%= `${obj.firstName} ${obj.lastName}` %>
            </li>
          </ol>

          <p class="me-md-5">
            <span class="fw-medium fs-6">Id :</span>
            <%= obj.uuid %>
          </p>
        </nav>

        <form
          onsubmit="editEmployee(event, '<%= obj.uuid %>')"
          class="mx-0 row gx-3 gy-4"
          style="padding: 0 2rem; margin-top: -0.85rem"
        >
          <div class="col-md-6">
            <label for="inputfirstName4" class="form-label">First Name:</label>
            <input
              value="<%= obj.firstName %>"
              type="text"
              class="form-control"
              id="inputfirstName4"
            />
          </div>
          <div class="col-md-6">
            <label for="inputlastName4" class="form-label">Last Name:</label>
            <input
              value="<%= obj.lastName%>"
              type="text"
              class="form-control"
              id="inputlastName4"
            />
          </div>

          <div class="col-md-6">
            <label for="inputemail4" class="form-label">Email:</label>
            <input
              value="<%= obj.email %>"
              type="email"
              class="form-control"
              id="inputemail4"
            />
          </div>
          <div class="col-md-6">
            <label for="inputtele4" class="form-label">Phone Number:</label>
            <input
              value="<%= obj.phoneNumber %>"
              type="string"
              class="form-control"
              id="inputtele4"
            />
          </div>

          <div>
            <div class="col-md-6">
              <label for="inputage4" class="form-label">Age:</label>
              <input
                value="<%= obj.age %>"
                type="number"
                class="form-control"
                id="inputage4"
              />
            </div>
          </div>

          <div>
            <div class="col-md-6">
              <label for="inputCountry" class="form-label">Country:</label>
              <select id="inputCountry" class="form-select">
                <% country_list.forEach(item => { %>
                <% if (obj.country === item) { %>
                <option value="<%= item %>" selected><%= item %></option>
                <% } else { %>
                <option value="<%= item %>"><%= item %></option>
                <% } %>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <div class="col-md-6">
              <label for="inputGender" class="form-label">Gender:</label>
              <select id="inputGender" class="form-select">
                <% gender_list.forEach((g) => { %>
                <% if(g === obj.gender) { %>
                <option value="<%= g %>" selected><%= g %></option>
                <% } else { %>
                <option value="<%= g %>"><%= g %></option>
                <% } %>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="col-12">
            <button
              type="submit"
              class="btn btn-primary"
              style="position: relative; left: 4%; width: 20%"
            >
              Update Changes
            </button>
            <button
              data-bs-toggle="modal"
              data-bs-target="#exampleModal"
              type="button"
              class="btn btn-danger"
              style="position: relative; left: 5%; width: 20%"
              onclick="setDeleteUuid('<%= obj.uuid %>')"
            >
              Delete Employee
            </button>
          </div>
        </form>
      </section>
    </main>

    <!-- Modal -->
    <div
      class="modal fade"
      id="exampleModal"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">
              Delete Employee
            </h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            Are you sure you want to continue delete the employee?
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
            <button
              type="button"
              class="btn btn-danger"
              onclick="deleteEmployee()"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      const uuid = "<%= uuid %>";
      fetch(`/api/edit/${uuid}`)
        .then((res) => {
          if (!res.ok) {
            throw new Error("API validation failed");
          }
          return res.json();
        })
        .then((data) => {
          console.log("API validation success", data);
        })
        .catch((err) => {
          console.log(err);
          document.body.innerHTML = `
          <h1 style="text-align: center; margin-top: 25%">Error loading employee data</h1>
        `;
        });
    </script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebars.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/editEmployee.js"></script>
    <script src="/js/deleteEmployee.js"></script>
  </body>
</html>
