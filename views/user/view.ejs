<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <script src="/js/color-modes.js"></script>
    <link
      rel="stylesheet"
      href="/bootstrap-icons-1.10.5/font/bootstrap-icons.min.css"
    />
    <link rel="shortcut icon" href="/img/ali.png" type="image/x-icon" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Khaled Zeyad" />
    <meta name="generator" content="rwx01" />
    <title>View Employee Details</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/dark-light.css" rel="stylesheet" />
    <link href="/css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/myStyle.css" />
  </head>
  <body>
    <%- include('../components/dark-light.ejs') %>

    <main class="d-flex flex-nowrap">
      <%- include('../components/sidebar.ejs', {currentPath: "view"}) %>

      <section class="w-100">
        <%- include('../components/navbar.ejs') %>
        <nav
          class="mt-4 d-flex flex-wrap justify-content-between"
          style="padding: 0 2rem"
          aria-label="breadcrumb"
        >
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              <%= `${obj.firstName} ${obj.lastName}` %>
            </li>
          </ol>

          <p>
            <span class="fw-medium fs-6">Id :</span>
            <%= obj.uuid %>
          </p>
        </nav>

        <table
          style="width: 80%; margin: auto"
          class="table mt-5 table-striped table-bordered"
        >
          <thead>
            <tr>
              <th scope="col">First Name</th>
              <th class="fw-normal" scope="col"><%= obj.firstName %></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Last Name</th>
              <td><%= obj.lastName %></td>
            </tr>

            <tr>
              <th scope="row">Telephone</th>
              <td><%= obj.phoneNumber %></td>
            </tr>

            <tr>
              <th scope="row">Email</th>
              <td><%= obj.email %></td>
            </tr>

            <tr>
              <th scope="row">Gender</th>
              <td><%= obj.gender %></td>
            </tr>

            <tr>
              <th scope="row">Age</th>
              <td><%= obj.age %></td>
            </tr>

            <tr>
              <th scope="row">Country</th>
              <td><%= obj.country %></td>
            </tr>

            <tr>
              <th scope="row">Created on</th>
              <td><%= moment(obj.createdAt).fromNow() %></td>
            </tr>

            <tr>
              <th scope="row">Last Update</th>
              <td><%= moment(obj.updatedAt).fromNow() %></td>
            </tr>
          </tbody>
        </table>
      </section>
    </main>

    <script>
      const uuid = "<%= uuid %>";
      fetch(`/api/view/${uuid}`)
        .then((res) => {
          if (!res.ok) {
            throw new Error("API validation failed");
          }
          return res.json();
        })
        .then((data) => {
          console.log("API validation success", data);
        })
        .catch((err) => {
          document.body.innerHTML = `
          <div style="text-align:center;margin-top:50px;">
            <h1>Error loading employee data</h1>
          </div>
        `;
        });
    </script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebars.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
